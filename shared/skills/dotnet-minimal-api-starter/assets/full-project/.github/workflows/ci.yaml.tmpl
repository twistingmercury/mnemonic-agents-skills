name: {{API_NAME}} CI

on:
  workflow_dispatch:
  push:
    branches: [{{CI_BRANCH}}]
  pull_request:
    branches: [{{CI_BRANCH}}]

permissions:
  contents: read

concurrency:
  group: ci-${{ github.workflow }}-${{ github.ref }}
  cancel-in-progress: true

jobs:
  build:
    runs-on: ubuntu-latest
    permissions:
      contents: read
      packages: write
    steps:
      - name: Checkout
        uses: actions/checkout@v7
        with:
          fetch-depth: 0

      - name: Log in to GHCR
        if: github.ref == 'refs/heads/{{CI_BRANCH}}' && (github.event_name == 'push' || github.event_name == 'workflow_dispatch')
        uses: docker/login-action@v4
        with:
          registry: ghcr.io
          username: ${{ github.actor }}
          password: ${{ secrets.GITHUB_TOKEN }}

      - name: Build and test the image
        id: build
        env:
          IMAGE_NAME: {{IMAGE_NAME}}
        run: LOCAL=0 ./build/build.sh

      - name: Push the image built by CI
        if: github.ref == 'refs/heads/{{CI_BRANCH}}' && (github.event_name == 'push' || github.event_name == 'workflow_dispatch')
        env:
          IMAGE_TAGS: ${{ steps.build.outputs.image_tags }}
        shell: bash
        run: |
          if [[ -z "${IMAGE_TAGS}" ]]; then
            printf '%s\n' 'The build did not report any image tags.' >&2
            exit 1
          fi
          while IFS= read -r image; do
            docker push "${image}"
          done <<< "${IMAGE_TAGS}"
