#!/usr/bin/env bash

set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
IMAGE_NAME="${DATABASE_IMAGE_NAME:-{{DATABASE_IMAGE_NAME}}}"
DATE_TAG="${DATE_TAG:-$(date -u +%Y-%m-%d)}"
PUSH="${PUSH:-0}"

fail() {
    printf 'Error: %s\n' "$1" >&2
    exit 1
}

registry_host() {
    local first_component="${IMAGE_NAME%%/*}"

    if [[ "${first_component}" == *.* || "${first_component}" == *:* || "${first_component}" == localhost ]]; then
        printf '%s' "${first_component}"
        return 0
    fi

    printf '%s' 'docker.io'
}

login_if_configured() {
    local registry

    if [ -z "${REGISTRY_USERNAME:-}" ] && [ -z "${REGISTRY_TOKEN:-}" ]; then
        return 0
    fi
    [ -n "${REGISTRY_USERNAME:-}" ] || fail 'REGISTRY_USERNAME is required when REGISTRY_TOKEN is set.'
    [ -n "${REGISTRY_TOKEN:-}" ] || fail 'REGISTRY_TOKEN is required when REGISTRY_USERNAME is set.'

    registry="${REGISTRY_HOST:-$(registry_host)}"
    printf '%s' "${REGISTRY_TOKEN}" | docker login "${registry}" \
        --username "${REGISTRY_USERNAME}" --password-stdin
}

main() {
    [ "$#" -eq 0 ] || fail 'build.sh does not accept arguments.'
    [[ "${PUSH}" =~ ^[01]$ ]] || fail 'PUSH must be 0 or 1.'
    command -v docker >/dev/null 2>&1 || fail 'docker is required.'
    [ -f "${SCRIPT_DIR}/Dockerfile" ] || fail "Dockerfile not found: ${SCRIPT_DIR}/Dockerfile"

    docker build --file "${SCRIPT_DIR}/Dockerfile" \
        --tag "${IMAGE_NAME}:test" \
        --tag "${IMAGE_NAME}:${DATE_TAG}" \
        "${SCRIPT_DIR}"

    if [ "${PUSH}" -eq 0 ]; then
        return 0
    fi

    login_if_configured
    docker push "${IMAGE_NAME}:test"
    docker push "${IMAGE_NAME}:${DATE_TAG}"
}

main "$@"
