{{- if .Values.networkPolicy.enabled }}
apiVersion: networking.k8s.io/v1
kind: NetworkPolicy
metadata:
  name: {{ include "{{PROJECT_SLUG}}.fullname" . }}-from-envoy
spec:
  podSelector:
    matchLabels:
      {{- include "{{PROJECT_SLUG}}.selectorLabels" . | nindent 6 }}
  policyTypes: [Ingress]
  ingress:
    - from:
        - podSelector:
            matchLabels:
              app: envoy
      ports:
        - protocol: TCP
          port: 8080
{{- end }}
