apiVersion: v1
kind: Service
metadata:
  name: {{ include "{{PROJECT_SLUG}}.fullname" . }}-postgres
spec:
  type: ClusterIP
  ports:
    - name: postgres
      port: {{ .Values.postgres.port }}
      targetPort: postgres
  selector:
    app.kubernetes.io/name: postgres
    app.kubernetes.io/instance: {{ .Release.Name }}
