FROM mcr.microsoft.com/dotnet/sdk:10.0-alpine AS build

WORKDIR /src
COPY src/{{API_NAME}}/ ./{{API_NAME}}/
COPY src/Tests/Unit/ ./Tests/Unit/
WORKDIR /src/{{API_NAME}}

RUN dotnet restore
RUN dotnet restore /src/Tests/Unit/{{API_NAME}}.Tests.Unit.csproj
RUN dotnet format --verify-no-changes --no-restore
RUN dotnet format /src/Tests/Unit/{{API_NAME}}.Tests.Unit.csproj --verify-no-changes --no-restore
RUN dotnet build --no-restore --configuration Release -warnaserror
RUN dotnet build /src/Tests/Unit/{{API_NAME}}.Tests.Unit.csproj --no-restore --configuration Release -warnaserror
RUN dotnet test /src/Tests/Unit/{{API_NAME}}.Tests.Unit.csproj --no-build --no-restore --configuration Release
RUN dotnet package list --no-restore --vulnerable --include-transitive
RUN dotnet publish --no-restore --configuration Release --output /app/publish

FROM mcr.microsoft.com/dotnet/aspnet:10.0-alpine AS final

ARG VERSION=dev
ARG DATE=unknown
ARG COMMIT=unknown

LABEL org.opencontainers.image.title="{{API_NAME}}" \
      org.opencontainers.image.created="${DATE}" \
      org.opencontainers.image.revision="${COMMIT}" \
      org.opencontainers.image.version="${VERSION}"

EXPOSE 8080
WORKDIR /app
COPY --from=build /app/publish .
ENTRYPOINT ["dotnet", "{{API_NAME}}.dll"]
